# Define the registry explicitly to prevent drifting registry hosts
registry=https://registry.npmjs.org/

# Configuration for deterministic and hoised monorepo installations
shamefully-hoist=true
strict-peer-dependencies=false

# Avoid lockfile modifications in CI environments
frozen-lockfile=false

# Set retry and timeouts for network resilience
fetch-retries=5
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
