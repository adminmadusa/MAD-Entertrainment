{
  "name": "mad-entertrainment",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/cleanup-ports.js && turbo dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test": "vitest run",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "audit-data": "tsx ./scripts/gather-audit-data.ts",
    "governance:init": "pnpm --filter @esparex/governance-cli start init",
    "governance:doctor": "pnpm --filter @esparex/governance-cli start doctor",
    "governance:status": "pnpm --filter @esparex/governance-cli start status",
    "governance:cleanup": "pnpm --filter @esparex/governance-cli start cleanup",
    "governance:walkthrough": "pnpm --filter @esparex/governance-cli start walkthrough",
    "governance:pr": "pnpm --filter @esparex/governance-cli start pr",
    "governance:backlog": "pnpm --filter @esparex/governance-cli start backlog",
    "governance:roadmap": "pnpm --filter @esparex/governance-cli start roadmap",
    "governance:changelog": "pnpm --filter @esparex/governance-cli start changelog",
    "governance:release": "pnpm --filter @esparex/governance-cli start release",
    "governance:baseline": "pnpm --filter @esparex/governance-cli start baseline",
    "governance:docs": "tsx scripts/governance/index.ts",
    "governance:fix": "tsx scripts/governance/cli/fix.ts",
    "governance:session": "tsx scripts/governance/cli/session.ts",
    "governance:rollback": "tsx scripts/governance/cli/rollback.ts",
    "governance:ui-baseline": "tsx scripts/governance/gather-ui-baseline.ts",
    "governance:branch-cleanup": "tsx scripts/governance/branch-cleanup.ts",
    "test:ui-governance": "playwright test --config=playwright.config.ts",
    "audit:dead-code": "knip --no-exit-code"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.60.0",
    "@sentry/nextjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@vitest/coverage-v8": "^4.1.7",
    "knip": "^5.45.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "ws": "^8.21.0",
      "socket.io-parser": "^4.2.7",
      "postcss": "^8.5.18",
      "sharp": "^0.35.5",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@2": "2.1.6",
      "fast-uri": "^3.1.9",
      "js-yaml": "^4.3.1",
      "nanoid": "^3.3.18",
      "serialize-javascript": "^7.0.3",
      "uuid": "^11.1.1",
      "body-parser": "^1.20.9",
      "browserslist": "^4.28.7",
      "engine.io": "^6.6.10",
      "source-map-js": "^1.2.2",
      "proxy-addr": "^2.0.8",
      "follow-redirects": "^1.16.2"
    }
  }
}
