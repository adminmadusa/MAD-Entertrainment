# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# Required. Use a MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://localhost:27017/mad-entertrainment

# ── Cache / Rate-Limiting ─────────────────────────────────────────────────────
# Optional but strongly recommended. Rate limiting degrades to per-instance
# in-memory store when Redis is unavailable.
REDIS_URL=redis://localhost:6379

# ── Auth Secrets ──────────────────────────────────────────────────────────────
# All three are REQUIRED — the server will refuse to start without them.
# Minimum 32 characters each. Use a secrets manager or `openssl rand -hex 32`.
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=replace-with-at-least-32-characters
JWT_ADMIN_EXPIRES_IN=1d
# Separate session secret used for checkout session tokens.
JWT_SESSION_SECRET=replace-with-at-least-32-characters

# ── CORS Allowlist ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
ALLOWED_ORIGINS=https://madmin.esparex.in,https://mad.esparex.in,http://localhost:3000,http://localhost:3001

# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Payment — Razorpay ────────────────────────────────────────────────────────
# Use test keys (rzp_test_...) for local/staging; live keys for production only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the webhook secret configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── Payment — Stripe (optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Payment Safety Flag ───────────────────────────────────────────────────────
# CRITICAL: Keep this "false" in staging and production.
# Setting to "true" bypasses ALL real payment processing with mock orders.
# Only use "true" in isolated local development without real payment keys.
MOCK_PAYMENTS=false

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_ASYNC_CHECKOUT=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PAYMENT_MAX=20

# ── Observability (Sentry) ────────────────────────────────────────────────────
# Optional — Sentry is silently disabled when not set.
# Obtain DSN from https://sentry.io → Project Settings → Client Keys.
SENTRY_DSN=

# ── Outbox Worker Tuning ──────────────────────────────────────────────────────
# These defaults are safe for most deployments. Only adjust if you observe
# booking confirmation or email delivery lag under real load.
OUTBOX_WORKER_BATCH_SIZE=20
OUTBOX_WORKER_POLL_INTERVAL_MS=2000
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_WORKER_HEARTBEAT_MS=5000
OUTBOX_STALE_LOCK_MS=60000
OUTBOX_MAX_ATTEMPTS=8
