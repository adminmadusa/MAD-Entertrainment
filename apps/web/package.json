{
  "name": "@mad/web",
  "version": "1.0.0",
  "private": true,
  "description": "MAD Entertrainment — Next.js Frontend",
  "scripts": {
    "prebuild": "rm -rf .next",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "circular-check": "madge --extensions ts,tsx --ts-config tsconfig.json --circular src",
    "dead-code-check": "depcheck",
    "clean": "rm -rf .next out",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@mad/shared": "workspace:*",
    "@mad/types": "workspace:*",
    "@mad/ui": "workspace:*",
    "@mad/utils": "workspace:*",
    "@mad/validations": "workspace:*",
    "@tanstack/react-query": "^5.62.16",
    "@tanstack/react-query-devtools": "^5.62.16",
    "axios": "^1.7.9",
    "framer-motion": "^11.15.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
