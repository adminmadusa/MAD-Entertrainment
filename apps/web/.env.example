# ── API & App URLs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://apm.esparex.in/api
NEXT_PUBLIC_SOCKET_URL=https://apm.esparex.in
NEXT_PUBLIC_APP_URL=https://mad.esparex.in

# ── Payment — Razorpay ────────────────────────────────────────────────────────
# Use test key (rzp_test_...) for local/staging; live key for production only.
# Must match RAZORPAY_KEY_ID on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Observability (Sentry) ────────────────────────────────────────────────────
# Optional — frontend error tracking is silently disabled when not set.
# Obtain DSN from https://sentry.io → Project Settings → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
